FROM mcr.microsoft.com/playwright:v1.65.0-noble@sha256:6e3fb709361521eb27161606e6da6d2674e5e89fa16516cb37d6fdd91372273d
LABEL org.opencontainers.image.source="https://github.com/Hostlier/hostlier-packages"
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openbox xterm xdotool scrot x11-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/hostlier-sandbox
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY *.mjs ./
ENV HOME=/tmp/home XDG_CONFIG_HOME=/tmp/home/.config XDG_CACHE_HOME=/tmp/home/.cache SANDBOX_MODE=computer SANDBOX_PORT=9333 DISPLAY=:99
USER pwuser
ENTRYPOINT ["node", "/opt/hostlier-sandbox/server.mjs"]
