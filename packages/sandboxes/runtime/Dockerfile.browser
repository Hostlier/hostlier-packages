FROM mcr.microsoft.com/playwright:v1.65.0-noble@sha256:6e3fb709361521eb27161606e6da6d2674e5e89fa16516cb37d6fdd91372273d
LABEL org.opencontainers.image.source="https://github.com/Hostlier/hostlier-packages"
WORKDIR /opt/hostlier-sandbox
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY *.mjs ./
ENV HOME=/tmp/home XDG_CONFIG_HOME=/tmp/home/.config XDG_CACHE_HOME=/tmp/home/.cache SANDBOX_MODE=browser SANDBOX_PORT=9222
USER pwuser
ENTRYPOINT ["node", "/opt/hostlier-sandbox/server.mjs"]
