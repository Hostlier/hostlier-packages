# Experimental legacy Usefused prototype; user-connected Fused Engine support is deferred.
# Requires an installed executor JSON and compatible published Unified App.
version: 1
name: analytics
image: ghcr.io/acme/analytics:1.0
port: 3000
route: analytics.example.com
workflow:
  steps:
    - id: database
      package: railway
      config:
        engine: postgres
        mode: new-database
        database: analytics
      secrets:
        executionToken: fused-database-execution-token
        connection: railway-admin-connection
  bindings:
    DATABASE_URL: database.url
